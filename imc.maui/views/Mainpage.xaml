<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="imc.maui.views.Mainpage"
             Title="Índice de masa corporal">
    <ScrollView>
        <Grid 
            RowDefinitions="Auto,Auto,*"
            ColumnDefinitions="*"
            RowSpacing="24"
           Padding="24"
            >
            <Border
            Stroke="LightGray"
            StrokeThickness="2"
        >
                <Grid
                    RowDefinitions="*,*"
                    ColumnDefinitions="auto,*"
                    ColumnSpacing="8"
                    RowSpacing="8"
            Padding="18"
            >
                    <Label
                Text="propocione el peso en kilogramos:"
                        Grid.Column="0"
                        Grid.Row="0">

                    </Label>
                    <Entry 
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Path=Peso}">
                    </Entry>
                    <Label
                Text="propocione la estaltura en metros:"
                        Grid.Row="1"
                        Grid.Column="0">

                    </Label>
                    <Entry
                        Text="{Binding Path=Estatura}"
                        Grid.Column="1"
                        Grid.Row="1"
                        >
                        
                    </Entry>
                </Grid>
            </Border>
            <HorizontalStackLayout 
                Grid.Row="1"
                Grid.Column="0"
            
                    HorizontalOptions="Center"
                    Margin="16"
                    Spacing="24">
                <Button 
                    Text="calcular"
                    BackgroundColor="Green"
                    Command="{Binding Path=CalcularCommand}"
                    >

                </Button>
                <Button 
                    Text="limpiar"
                    Command="{Binding Path=LimpiarCommand}">
                    
                </Button>
            </HorizontalStackLayout>
            <Border 
                Grid.Row="2"
                Grid.Column="2"
                    Stroke="LightGray"
                    StrokeThickness="2"
                    >
                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="10">
                    </RoundRectangle>
                </Border.StrokeShape>
                <VerticalStackLayout 
            Padding="18"
            Spacing="8">
                    <Label Text="el indice de masa corporal es:"></Label>
                    <Label Text="{Binding Path=Imc}" 
                           HorizontalOptions="Center"
                           FontSize="Medium" 
                           FontAttributes="Bold"
                           >
                        
                    </Label>
                    <Label Text="La situacion nutricional de la persona es:"></Label>
                    <Label Text="{Binding Path=EstadoNutricional} " 
                           HorizontalOptions="Center" 
                           FontSize="Medium" 
                           FontAttributes="Bold"
                           >
                        
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>


</ContentPage>